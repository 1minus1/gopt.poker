RewriteEngine On
RewriteRule ^api/history/current$ api/history-current.php [L]
RewriteRule ^api/history/versions$ api/history-versions.php [L]
RewriteRule ^api/history/versions\.zip$ api/history-versions-zip.php [L]
RewriteRule ^api/history/revert$ api/history-revert.php [L]
RewriteRule ^api/history/delete$ api/history-delete.php [L]
RewriteRule ^api/matrix$ api/matrix.php [L]
RewriteRule ^api/matrix/export$ api/matrix-export.php [L]
RewriteRule ^api/matrix/attendance-summary$ api/matrix-attendance-summary.php [L]
RewriteRule ^upload-matrix-history$ api/matrix-upload.php [L]
RewriteRule ^upload-history$ api/history-upload.php [L]
